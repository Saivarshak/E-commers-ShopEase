# ShopEase production environment template.
# Copy this file to an untracked production file such as `.env.production`,
# replace every placeholder, then select it explicitly when running Compose:
#   $env:ENV_FILE = '.env.production'
#   docker compose --env-file $env:ENV_FILE up -d --build
# `.env.production` is intentionally ignored by Git. Do not use the local
# development `.env` as a container deployment configuration.

# ---------------------------------------------------------------- edge / TLS
# Public site address handled by Caddy. Use the bare domain (Caddy obtains and
# renews Let's Encrypt certificates automatically when ports 80/443 are open
# and the domain's DNS A/AAAA record points at this host).
CADDY_SITE=shop.example.com

# ---------------------------------------------------------------- Django core
DJANGO_ENV=production
IS_PRODUCTION=true
DEBUG=false
SECRET_KEY=replace-with-a-long-random-django-secret-key
TIME_ZONE=Asia/Kolkata
LOG_LEVEL=INFO

# Public application URL. Also folded into ALLOWED_HOSTS and
# CSRF_TRUSTED_ORIGINS by settings.py, and used for Razorpay callbacks.
APP_BASE_URL=https://shop.example.com
PAYMENT_CALLBACK_BASE_URL=https://shop.example.com
ALLOWED_HOSTS=shop.example.com,www.shop.example.com
CSRF_TRUSTED_ORIGINS=https://shop.example.com,https://www.shop.example.com
CORS_ALLOWED_ORIGINS=

# ---------------------------------------------------------------- database
# The web container connects to the `db` Compose service (service DNS name),
# never to a loopback address. This Docker stack deliberately ignores
# DATABASE_URL and uses the persistent `postgres_data` volume instead.
POSTGRES_DB=shopease
POSTGRES_USER=shopease
POSTGRES_PASSWORD=replace-with-a-long-unique-postgres-password
POSTGRES_HOST=db
POSTGRES_PORT=5432
DATABASE_URL=
DATABASE_SSL_REQUIRE=false
DB_CONN_MAX_AGE=600

# ---------------------------------------------------------------- proxy/TLS
# Caddy terminates TLS and forwards to Gunicorn with these headers set.
TRUST_X_FORWARDED_PROTO=true
USE_X_FORWARDED_HOST=true
SECURE_SSL_REDIRECT=true
SESSION_COOKIE_SECURE=true
CSRF_COOKIE_SECURE=true
SECURE_HSTS_SECONDS=31536000
SECURE_HSTS_INCLUDE_SUBDOMAINS=true
# Enable only after every subdomain is HTTPS-ready.
SECURE_HSTS_PRELOAD=false

# ---------------------------------------------------------------- runtime
RUN_MIGRATIONS=true
COLLECT_STATIC=true
WEB_CONCURRENCY=2
GUNICORN_THREADS=4
GUNICORN_TIMEOUT=120
GUNICORN_GRACEFUL_TIMEOUT=30
GUNICORN_KEEP_ALIVE=5

# ---------------------------------------------------------------- uploads
MAX_UPLOAD_IMAGE_BYTES=10485760

# ---------------------------------------------------------------- payments
# Keep payment mode in test until live credentials and webhook verification are
# complete. Do not commit actual Razorpay credentials.
RAZORPAY_MODE=test
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=
RAZORPAY_PAYMENT_LINK_OVERRIDE_URL=
RAZORPAY_PAYMENT_HANDLE_URL=

# ---------------------------------------------------------------- e-mail
# Email is console-only by default. Configure SMTP only when the provider and
# credentials are ready.
EMAIL_BACKEND=django.core.mail.backends.console.EmailBackend
EMAIL_HOST=
EMAIL_PORT=587
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=
EMAIL_USE_TLS=true
DEFAULT_FROM_EMAIL=noreply@shop.example.com

# ------------------------------------------------------------- OAuth (opt.)
GOOGLE_OAUTH_CLIENT_ID=
GOOGLE_OAUTH_CLIENT_SECRET=
